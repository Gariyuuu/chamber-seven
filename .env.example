# Copy to .env.local and fill in for local development.
# See CLAUDE.md -> Environment setup for the full explanation of each variable.

# Host (no protocol, no trailing slash) that the client connects its
# WebSocket to and builds the leaderboard HTTP URL from.
# Local dev (matches `wrangler dev --port 8787`):
NEXT_PUBLIC_PARTYKIT_HOST=127.0.0.1:8787
# Production value (confirmed via a real `wrangler deploy`, 2026-08-06
# — this Cloudflare account's subdomain happens to match the Worker
# name, so it's not a placeholder — see DEPLOYMENT.md):
# NEXT_PUBLIC_PARTYKIT_HOST=chamber-seven.chamber-seven.workers.dev

# VERCEL_OIDC_TOKEN is injected automatically by the Vercel CLI/platform.
# Do not set this by hand; do not commit a real value if it ever appears
# in your local .env.local.
